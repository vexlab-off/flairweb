# Maintainer: vex <https://github.com/vexlab-off>
# Paquet de publication : construit depuis l'archive de la version sur GitHub.
# (pkgbuild/PKGBUILD, lui, construit le dossier local pour bin/install.)
pkgname=flairweb
pkgver=0.2.0
pkgrel=1
pkgdesc="Navigateur web de la suite flair : moteur au choix, bouclier anti-pistage, extensions Chrome"
arch=('x86_64' 'aarch64')
url="https://github.com/vexlab-off/flairweb"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-wayland' 'xdg-desktop-portal' 'xdg-utils')
optdepends=('flair: afficher les téléchargements dans flair'
            'qt6-imageformats: icônes de sites en WebP et AVIF'
            'qt6-svg: icônes de sites en SVG')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  mkdir -p build
  cd build
  qmake6 ../flairweb.pro
  make
}

check() {
  cd "$pkgname-$pkgver"
  mkdir -p build/tests
  cd build/tests
  qmake6 ../../tests/flairweb_tests.pro
  make
  QT_QPA_PLATFORM=offscreen ./flairweb_tests
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/flairweb "$pkgdir/usr/bin/flairweb"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 pkgbuild/flairweb.desktop "$pkgdir/usr/share/applications/flairweb.desktop"
  install -Dm644 pkgbuild/flairweb.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/flairweb.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "pkgbuild/icons/flairweb-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/flairweb.png"
  done
}
